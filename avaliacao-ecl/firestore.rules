rules_version = '2';
// Regras da base de dados da aplicação Avaliação ECL.
// Só entra quem vem da aplicação (entrada anónima) e só nas coleções
// das turmas que a aplicação usa. (2.ª fase: também planos, fichas e
// aberturas da aula; as fichas ficam na «turma» _todas.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /turmas/{turma}/{colecao}/{id} {
      allow read, write: if request.auth != null
        && colecao in ['selecoes', 'validacoes', 'avaliacoes', 'presencas', 'planos', 'fichas', 'sessoes'];
    }
  }
}
