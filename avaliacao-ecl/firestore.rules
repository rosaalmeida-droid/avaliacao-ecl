rules_version = '2';
// Regras da base de dados da aplicação Avaliação ECL.
// Só entra quem vem da aplicação (entrada anónima) e só nas coleções
// das turmas que a aplicação usa. (2.ª fase: também planos, fichas e
// aberturas da aula; as fichas ficam na «turma» _todas. 3.ª fase: grupos,
// avaliação entre colegas e líder do KitchenFlow; as matérias-primas dos
// professores, na «turma» _todas.)
service cloud.firestore {
  match /databases/{database}/documents {
    match /turmas/{turma}/{colecao}/{id} {
      // (out/2026) Também as notas dos produtos da Makro, os alunos fantasma, as
      // definições da escola (e-mails das compras), os avisos à coordenação e as ocorrências.
      allow read, write: if request.auth != null
        && colecao in ['selecoes', 'validacoes', 'avaliacoes', 'presencas', 'planos', 'fichas', 'sessoes',
                       'grupos', 'gruposinfo', 'pares', 'lideres', 'materiasprimas',
                       'requisicoes', 'eventos', 'recuperacoes', 'evidencias',
                       'notasprodutos', 'fantasmas', 'configs', 'avisoscoord', 'ocorrencias'];
    }
  }
}
